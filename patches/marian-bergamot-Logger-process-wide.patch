  private:
   using MarianLogger = std::shared_ptr<spdlog::logger>;
+
+  // Marian's loggers as createLoggers() makes them, each taken from the
+  // registry when it's already there. ABORT() registers "general" itself when
+  // it finds none, possibly on another thread, so a registration that fails
+  // means the logger now exists: take that one.
+  static std::vector<MarianLogger> processLoggers() {
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    static const char *const names[][2] = {{"general", "[%Y-%m-%d %T] %v"},
+                                           {"valid", "[%Y-%m-%d %T] [valid] %v"}};
+    std::vector<MarianLogger> loggers;
+    for (const auto &name : names) {
+      MarianLogger logger = spdlog::get(name[0]);
+      if (!logger) {
+        try {
+          logger = createStderrLogger(name[0], name[1]);
+        } catch (const spdlog::spdlog_ex &) {
+          logger = spdlog::get(name[0]);
+        }
+      }
+      if (logger) loggers.push_back(logger);
+    }
+    return loggers;
+  }
+
   std::vector<MarianLogger> marianLoggers_;
