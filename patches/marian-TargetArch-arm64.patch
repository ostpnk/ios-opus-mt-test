diff --git a/inference/marian-fork/cmake/TargetArch.cmake b/inference/marian-fork/cmake/TargetArch.cmake
index f653e3e2..c3d84952 100644
--- a/inference/marian-fork/cmake/TargetArch.cmake
+++ b/inference/marian-fork/cmake/TargetArch.cmake
@@ -79,6 +79,11 @@ function(target_architecture output_var)
                 set(osx_arch_i386 TRUE)
             elseif("${osx_arch}" STREQUAL "x86_64")
                 set(osx_arch_x86_64 TRUE)
+            elseif("${osx_arch}" STREQUAL "arm64")
+                # Apple Silicon / iOS. Reported as armv8, the name the
+                # compile-time probe below gives aarch64, so Marian's ARM
+                # handling (ruy, NEON emulation) applies.
+                set(osx_arch_arm64 TRUE)
             elseif("${osx_arch}" STREQUAL "ppc64" AND ppc_support)
                 set(osx_arch_ppc64 TRUE)
             else()
@@ -99,6 +104,10 @@ function(target_architecture output_var)
             list(APPEND ARCH x86_64)
         endif()
 
+        if(osx_arch_arm64)
+            list(APPEND ARCH armv8)
+        endif()
+
         if(osx_arch_ppc64)
             list(APPEND ARCH ppc64)
         endif()
